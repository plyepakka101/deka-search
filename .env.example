# ========================================================
# Deka Search Environment Variables Example
# Duplicate this file to .env or .env.local and populate values
# ========================================================

# Database (Turso / LibSQL)
DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# NextAuth Authentication
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Google OAuth Provider
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Administrator Accounts (comma, semicolon, or newline separated emails)
ADMIN_EMAILS=admin@example.com,developer@example.com

# AI Evaluation (Google Gemini API Key)
# Optional for server fallback; users can also provide their own key in Settings
GEMINI_API_KEY=your_gemini_api_key
