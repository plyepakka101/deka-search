// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ImportBatch {
  id           String     @id @default(cuid())
  fileName     String
  importedAt   DateTime   @default(now())
  createdCount Int        @default(0)
  updatedCount Int        @default(0)
  decisions    Decision[]
}

model Decision {
  id                String   @id @default(cuid())
  decisionNumber    String   @unique // เลขที่คำพิพากษาศาลฎีกา (e.g., "1234/2565")
  decisionYear      Int?     // ปี พ.ศ. ของคำพิพากษา
  caseNumberSupreme String?  // หมายเลขคดีคำของศาลฎีกา
  caseNumberLower   String?  // หมายเลขคดีคำและแดงของศาลชั้นต้น
  parties           String?  // ชื่อคู่ความ
  law               String?  // ชื่อกฎหมาย
  shortSummary      String?  // ย่อสั้น
  longSummary       String?  // ย่อยาว
  source            String?  // แหล่งที่มา
  judge             String?  // ชื่อองค์คณะ
  court             String?  // ศาลชั้นต้นและศาลอุทธรณ์ที่ตัดสิน
  department        String?  // แผนก
  notes             String?  // หมายเหตุ
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  importBatchId     String?
  importBatch       ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([decisionYear])
  @@index([law])
}

model LawBook {
  id           String   @id @default(cuid())
  name         String
  abbreviation String
  content      String
  color        String
  description  String?
  sourceUrl    String?
  lastUpdated  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ExamCollection {
  id          String         @id @default(cuid())
  title       String         // e.g. "ข้อสอบเนติบัณฑิต ข้อ 7 (กฎหมายล้มละลายและการฟื้นฟูกิจการ)"
  category    String         // 1 ใน 9 หมวดที่กำหนด
  year        Int?           // ปี พ.ศ. ของข้อสอบ (เช่น 2545-2562)
  description String?        // รายละเอียดชุดข้อสอบ
  source      String?        // แหล่งที่มา (เช่น เนติบัณฑิตยสภา)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   ExamQuestion[]

  @@index([category])
  @@index([year])
}

model ExamQuestion {
  id               String         @id @default(cuid())
  collectionId     String
  collection       ExamCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  questionNumber   String         // e.g. "7.1", "7.2"
  title            String?        // ชื่อเรื่องสั้น (เช่น "การเพิกถอนการขายทอดตลาดทรัพย์จำนอง")
  facts            String         // ข้อเท็จจริงของโจทย์
  prompt           String         // คำถามวินิจฉัย (ขึ้นต้นด้วย "ให้วินิจฉัยว่า...")
  officialAnswer   String         // ธงคำตอบฉบับเต็ม
  examDate         String?        // e.g. "วันอาทิตย์ที่ 2 มิถุนายน 2545"
  examYear         Int?           // e.g. 2545
  
  category         String         // หมวดกฎหมาย 1 ใน 9 หมวด
  
  // JSON metadata arrays
  keyIssues        String         // JSON Array of strings e.g. ["เจ้าหนี้มีประกัน ม.6, 95", "อำนาจ จพท. ม.110 วรรคท้าย"]
  relatedSections  String         // JSON Array: [{ law: "พ.ร.บ.ล้มละลาย", section: "6" }]
  relatedDekas     String         // JSON Array: ["5744/2531", "593/2538", "3283/2532"]
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([category])
  @@index([collectionId])
  @@index([examYear])
}

